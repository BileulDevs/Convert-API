# Copy this file to .env (git-ignored) and set your own values before `docker compose up`.

# Password of the local PostgreSQL container. Any long random value works, for example:
#   PowerShell: [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(24))
#   Bash:       openssl rand -base64 24
# Avoid ' and ; which would break the connection string.
POSTGRES_PASSWORD=
